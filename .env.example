# ============================================
# CodeSentinel Environment Configuration
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ============================================

# --- Application ---
APP_NAME=CodeSentinel
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://codesentinel:codesentinel@localhost:5432/codesentinel
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# --- AI Provider (Gemini - Free) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Scanners ---
SEMGREP_ENABLED=true
GITLEAKS_ENABLED=true
SCAN_TIMEOUT_SECONDS=600
MAX_REPO_SIZE_MB=500
MAX_FILE_COUNT=10000

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=change-me-32-byte-base64-encoded-key

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=100/minute

# --- Worker ---
WORKER_CONCURRENCY=2
WORKER_QUEUE_NAME=codesentinel
